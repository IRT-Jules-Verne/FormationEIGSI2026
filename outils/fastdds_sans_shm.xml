<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Profil Fast DDS : transport UDP uniquement, sans memoire partagee (SHM), limite a la
  machine locale.
  Sous Windows, le transport SHM de Fast DDS provoque des blocages et des crashs des que
  plusieurs nœuds tournent (Nav2 en lance une dizaine) ou qu'un processus a ete tue sans
  menage ("Interprocess mutex timeout ... owner died without unlocking").

  Attention : quand un profil remplace les transports par defaut (useBuiltinTransports
  false), ROS_LOCALHOST_ONLY=1 n'a plus d'effet. La liste blanche 127.0.0.1 ci-dessous
  fait la meme chose : les nœuds ne communiquent qu'avec ceux de la meme machine, et ne
  voient pas ceux des autres etudiants.

  Active par la variable FASTRTPS_DEFAULT_PROFILES_FILE (voir pixi.toml).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_local_seulement</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="participant_udp_local" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_local_seulement</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
