<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cours_ros2_demo</name>
  <version>0.2.0</version>
  <description>Package de demonstration du cours ROS 2 : D8 (du code au noeud), D11 (launch) et les demonstrations 4.x du module navigation (pixi run cours demo:=4.2).</description>
  <maintainer email="ludovic.delval@irt-jules-verne.fr">Ludovic Delval</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <!-- Demonstrations du module 4 : reutilisent les launch files du TP navigation (nav_ws) -->
  <exec_depend>tb3_livreur</exec_depend>
  <exec_depend>tb3_loopback_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
