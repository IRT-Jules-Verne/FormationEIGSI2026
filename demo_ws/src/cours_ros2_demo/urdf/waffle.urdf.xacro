<?xml version="1.0"?>
<!--
  Modèle simplifié du TurtleBot3 Waffle, utilisé pour les démonstrations du cours (module 4).
  Même structure de repères que le Burger du TP, mais d'autres dimensions :
  châssis 281 x 306 mm, entraxe des roues 0,287 m, lidar en (-0,064 ; 0 ; 0,122).
-->
<robot name="turtlebot3_waffle" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="scan_yaw" default="0.0"/>

  <xacro:property name="roue_rayon"   value="0.033"/>
  <xacro:property name="roue_largeur" value="0.018"/>
  <xacro:property name="roue_entraxe" value="0.287"/>

  <material name="gris_fonce"><color rgba="0.30 0.30 0.30 1.0"/></material>
  <material name="noir"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="bleu"><color rgba="0.10 0.30 0.80 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.055" rpy="0 0 0"/>
      <geometry><box size="0.281 0.306 0.100"/></geometry>
      <material name="gris_fonce"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.055" rpy="0 0 0"/>
      <geometry><box size="0.281 0.306 0.100"/></geometry>
    </collision>
  </link>

  <xacro:macro name="roue" params="prefixe y">
    <joint name="wheel_${prefixe}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefixe}_link"/>
      <origin xyz="0 ${y} 0.023" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_${prefixe}_link">
      <visual>
        <geometry><cylinder length="${roue_largeur}" radius="${roue_rayon}"/></geometry>
        <material name="noir"/>
      </visual>
      <collision>
        <geometry><cylinder length="${roue_largeur}" radius="${roue_rayon}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:roue prefixe="left"  y="${roue_entraxe / 2}"/>
  <xacro:roue prefixe="right" y="${-roue_entraxe / 2}"/>

  <xacro:macro name="roulette" params="prefixe x y">
    <joint name="caster_${prefixe}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefixe}_link"/>
      <origin xyz="${x} ${y} -0.004" rpy="0 0 0"/>
    </joint>
    <link name="caster_${prefixe}_link">
      <visual>
        <geometry><sphere radius="0.008"/></geometry>
        <material name="noir"/>
      </visual>
    </link>
  </xacro:macro>
  <xacro:roulette prefixe="back_left"  x="-0.177" y="0.064"/>
  <xacro:roulette prefixe="back_right" x="-0.177" y="-0.064"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 $(arg scan_yaw)"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <geometry><cylinder length="0.030" radius="0.035"/></geometry>
      <material name="bleu"/>
    </visual>
    <visual>
      <origin xyz="0.030 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.006 0.006"/></geometry>
      <material name="noir"/>
    </visual>
  </link>

</robot>
